OPENAQ_API_KEY=
# Minimum usable PM2.5 station-hours before trying CAMS.
MIN_OBSERVED_HOURS=720

# Required only for Gemini chat. No canned chat fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
LIVE_REFRESH_ENABLED=1
LIVE_REFRESH_SECONDS=3600
# Optional alternative providers, not required for current integrations:
DATA_GOV_IN_API_KEY=
OPENWEATHER_API_KEY=
NASA_FIRMS_MAP_KEY=
