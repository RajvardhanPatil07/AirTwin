OPENAQ_API_KEY=
# Optional managed PostgreSQL URL (for example, Railway's DATABASE_URL).
# Provider snapshots are retained for 30 days; the app still runs without it.
DATABASE_URL=
# Minimum usable PM2.5 station-hours before trying CAMS.
MIN_OBSERVED_HOURS=720

# Gemini chat. Without a key, Ask AirTwin shows a labeled evidence summary.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LIVE_REFRESH_ENABLED=1
LIVE_REFRESH_SECONDS=3600
# OpenAQ historical sensor-hour backfills per refresh (bounded to avoid rate limits).
LIVE_HISTORY_MAX_SENSORS=12
# For Supabase use the *backend-only* PostgreSQL DATABASE_URL from Project > Connect.
# Never put a database password in VITE_ variables or commit credentials.
# Optional alternative providers, not required for current integrations:
DATA_GOV_IN_API_KEY=
OPENWEATHER_API_KEY=
NASA_FIRMS_MAP_KEY=

# Comma-separated deployed frontend origins; localhost ports are allowed automatically.
CORS_ORIGINS=

# Historical ingestion is a separate explicit one-time CLI, never a 45-day
# request on every hourly refresh. Run from repository root:
# python backend/scripts/backfill_openaq_history.py --days 45 --max-sensors 23
# python backend/scripts/export_observed_history.py --days 90 --min-station-hours 720
